			<Text>Chaco Trail</Text>
		</Row>
		<Row Tag="LOC_NODE_CIVIC_AQ_PUEBLOANS_FIELD_OF_FORTUNE_NAME">
			<Text>Chaco Road</Text>
		</Row>
		<Row Tag="LOC_NODE_CIVIC_AQ_PUEBLOANS_FIELD_OF_FORTUNE_DESCRIPTION">
			<Text>Roads on desert tiles yield +2 culture.</Text>
		</Row>

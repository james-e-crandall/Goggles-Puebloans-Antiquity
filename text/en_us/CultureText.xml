		<!-- NODE_CIVIC_AQ_PUEBLOANS_TAGAUNG_KINGDOM -->
		<Row Tag="LOC_NODE_CIVIC_AQ_PUEBLOANS_TAGAUNG_KINGDOM_QUOTE">
			<Text>Stone is the shelter of the people; desert is the teacher of patience.</Text>
		</Row>
		<Row Tag="LOC_NODE_CIVIC_AQ_PUEBLOANS_TAGAUNG_KINGDOM_QUOTE_AUTHOR">
			<Text>Pueblo Wisdom</Text>
		</Row>
		<Row Tag="LOC_NODE_CIVIC_AQ_PUEBLOANS_TAGAUNG_KINGDOM_NAME">
			<Text>Basketmaker Culture</Text>
		</Row>
		<Row Tag="LOC_NODE_CIVIC_AQ_PUEBLOANS_TAGAUNG_KINGDOM_DESCRIPTION">
			<Text>Tier 1 civic rooted in desert stewardship and early communal culture.</Text>
		</Row>
